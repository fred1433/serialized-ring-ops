{
  "name": "serialized-ring-ops",
  "version": "0.1.0",
  "private": true,
  "description": "One serialized smart ring from manifest to delivery, on fictional orders. NestJS, TypeScript, PostgreSQL.",
  "license": "MIT",
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "jest --runInBand",
    "race": "tsx scripts/race-report.ts",
    "export:state": "tsx scripts/export-state.ts",
    "build:page": "tsx scripts/build-page.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "18.5.0",
    "tslib": "2.8.1",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "esbuild": "0.25.9",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "typescript": "5.9.2"
  }
}
